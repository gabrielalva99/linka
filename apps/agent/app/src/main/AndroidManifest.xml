<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permite reabrir a vitrine sozinho quando o cliente sai do app e larga o
         aparelho em outra tela. Concedida no provisionamento (appops). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Faxina diária: apagar fotos/vídeos que o cliente deixou no aparelho.
         Concedida no provisionamento (appops), como dono do aparelho. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Telemetria de interação: quais telas o cliente abriu e por quanto tempo.
         Sem DECLARAR aqui, o comando de concessão no provisionamento não tem o
         que conceder e falha em silêncio. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ver o que está instalado no aparelho. A partir do Android 11 um app só
         enxerga a si mesmo, então sem isto a lista chega VAZIA e a faxina volta a
         depender de uma lista escrita à mão.
         É permissão ampla e existe de propósito: somos dono do aparelho e o app
         não é distribuído pela Play Store. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Subir sozinho quando o aparelho liga. Sem isto, só o cargo de dono do
         aparelho trazia a vitrine de volta depois de um reinício, e a frota de
         instalação assistida não tem esse cargo: a loja tirava da tomada e a
         vitrine ficava preta até alguém abrir o app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- directBootAware no APLICATIVO inteiro, e não num componente solto.
         O LINKA é a tela inicial obrigatória do aparelho. O Android precisa
         encontrar uma tela inicial para terminar de iniciar o usuário, e nessa
         fase ele só enxerga componentes preparados para rodar antes do
         destravamento. Sem isto não existe tela inicial nenhuma no aparelho
         (nem a nossa, nem a da Motorola), e o boot não termina nunca.
         Por isso o Prefs mora no armazenamento protegido por aparelho. -->
    <application
        android:directBootAware="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- HOME e DEFAULT existem por um motivo que custou caro para
                     descobrir. O provisionamento diz ao Android, via dono do
                     aparelho, "para a tela inicial use sempre o LINKA"
                     (Kiosk.addPersistentPreferredActivity). Sem declarar aqui
                     que esta tela SABE ser tela inicial, o Android fica com uma
                     ordem apontando para uma tela que não atende, não encontra
                     substituto, e o log diz exatamente isto:

                        No home screen found for Intent { MAIN + HOME } user 0

                     A partir daí o usuário do sistema nunca termina de iniciar e
                     o aparelho fica na animação de boot para sempre. Não aparece
                     no provisionamento porque o launcher antigo ainda está de pé:
                     só o PRIMEIRO REINÍCIO revela. Dois aparelhos de teste
                     ficaram inutilizáveis até isto ser encontrado. -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A vitrine volta sozinha depois de qualquer reinício.
             SEM directBootAware e SEM LOCKED_BOOT_COMPLETED, e isso não é
             detalhe: com eles, o receptor roda ANTES de o aparelho destravar,
             fase em que a memória do app ainda não existe. A leitura falhava, o
             processo morria — e como o LINKA é a tela inicial deste aparelho, o
             sistema ficava esperando uma tela que nunca subia. Dois aparelhos de
             teste ficaram presos na inicialização por minutos.
             BOOT_COMPLETED sozinho chega depois do destravamento, que é quando
             a vitrine tem como funcionar de verdade. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Recebe o cargo de dono do aparelho (ADR-7). -->
        <receiver
            android:name=".LinkaDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".HeartbeatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
