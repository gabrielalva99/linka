<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── O QUE FAZ A TV ACEITAR ESTE APP ──────────────────────────────────
         Sem estas duas linhas o LINKA some do lançador da Android TV: medido em
         31/08 no primeiro box, `query-activities` da categoria de TV devolvia
         ZERO entradas do LINKA. Ele só subia por comando pelo cabo — ou seja,
         numa loja, depois de um reinício, ninguém conseguiria abrir a vitrine.

         `required="false"` nas duas de propósito: elas DECLARAM que o app sabe
         funcionar em TV, sem exigir TV. O mesmo APK continua instalando em
         celular e tablet (ADR-10: uma frota só, um APK só). Marcar `true`
         faria o contrário do que se quer — excluiria os 250 aparelhos de mão. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- A TV não tem tela de toque. Sem declarar que o toque é dispensável, a
         instalação é recusada em aparelho sem toque. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Cadastrar a rede da loja pelo painel. Só o dono do aparelho consegue: para
         app comum o Android recusa desde o 10. NÃO pede localização de propósito —
         cadastrar rede não precisa, e diálogo de permissão na vitrine é defeito. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permite reabrir a vitrine sozinho quando o cliente sai do app e larga o
         aparelho em outra tela. Concedida no provisionamento (appops). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Faxina diária: apagar fotos/vídeos que o cliente deixou no aparelho.
         Concedida no provisionamento (appops), como dono do aparelho. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Telemetria de interação: quais telas o cliente abriu e por quanto tempo.
         Sem DECLARAR aqui, o comando de concessão no provisionamento não tem o
         que conceder e falha em silêncio. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Ver o que está instalado no aparelho. A partir do Android 11 um app só
         enxerga a si mesmo, então sem isto a lista chega VAZIA e a faxina volta a
         depender de uma lista escrita à mão.
         É permissão ampla e existe de propósito: somos dono do aparelho e o app
         não é distribuído pela Play Store. -->
    <!-- Sem isto o pedido de desinstalação é ENGOLIDO pelo Android: sem
         exceção, sem log, sem nada na tela. Foi o que fez o botão "Desinstalar
         o LINKA" não fazer nada depois da retirada para venda (visto pelo
         Gabriel no aparelho, 19/08) — o controle voltava, o app dizia que
         estava pronto, e o passo final simplesmente não acontecia. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ATUALIZAR SOZINHO SEM SER DONO DO APARELHO.
         Estas duas existem por causa da TV. O box Android TV nao aceita virar
         dono do aparelho (a build vem sem device_admin), e sem dono o
         SelfUpdate parava na porta: uma TV em loja congelaria para sempre na
         versao com que foi instalada, e cada correcao viraria visita com cabo.

         A regra do Android para instalar em silencio, desde a 12 (API 31): o
         app instalado precisa mirar API alta (o limite sobe com a versao do
         sistema — 29 no Android 12, 31 no Android 14; miramos 34, entao passa
         com folga), o instalador precisa ser o PROPRIO APP se atualizando (e o
         nosso caso) e precisa declarar UPDATE_PACKAGES_WITHOUT_USER_ACTION.

         REQUEST_INSTALL_PACKAGES nao basta declarar: ela e um appop, o
         "instalar apps desconhecidos" dos ajustes, e precisa ser CONCEDIDA. Quem
         concede e o preparar-box.sh, que tambem grava em disco — sem a gravacao
         o ajuste se perde no primeiro reinicio, e a atualizacao morre em loja
         depois de funcionar na bancada (medido em 07/09).

         Custo: REQUEST_INSTALL_PACKAGES e permissao sensivel na Play e nao
         estava no pedido de liberacao do DPC de 25/08. UPDATE_PACKAGES_... e
         normal, concedida automaticamente. Em aparelho de mao nada muda: la o
         cargo de dono continua sendo o caminho, e este e o plano B do dia em
         que um celular perder o cargo em loja. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Subir sozinho quando o aparelho liga. Sem isto, só o cargo de dono do
         aparelho trazia a vitrine de volta depois de um reinício, e a frota de
         instalação assistida não tem esse cargo: a loja tirava da tomada e a
         vitrine ficava preta até alguém abrir o app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- directBootAware no APLICATIVO inteiro, e não num componente solto.
         O LINKA é a tela inicial obrigatória do aparelho. O Android precisa
         encontrar uma tela inicial para terminar de iniciar o usuário, e nessa
         fase ele só enxerga componentes preparados para rodar antes do
         destravamento. Sem isto não existe tela inicial nenhuma no aparelho
         (nem a nossa, nem a da Motorola), e o boot não termina nunca.
         Por isso o Prefs mora no armazenamento protegido por aparelho. -->
    <!-- android:banner — cartão do lançador de TV. A Android TV ignora o ícone
         e exige banner; sem ele o app não aparece na lista de aplicativos mesmo
         com a categoria de TV declarada abaixo. -->
    <application
        android:directBootAware="true"
        android:label="@string/app_name"
        android:banner="@drawable/banner_tv"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- singleTask: UMA tarefa, UMA instancia, sempre.
             Sem isto o Android usa LAUNCH_MULTIPLE, e tres caminhos nossos abrem
             esta tela (o retorno automatico do servico, o pedido de retrancar e o
             receptor de app substituido). Cada um criava uma tarefa NOVA ao lado
             da anterior. O log de uma atualizacao mostra o estrago em duas linhas:

                Add Task{#40} to hidden list because adding Task{#41}
                Activity pause timeout for ActivityRecord{... t41}

             Duas tarefas do mesmo app, o sistema malabarizando as duas ate
             estourar o tempo de transicao de ciclo de vida. Sao os ~10 segundos
             cronometrados entre a atualizacao e o video voltar. Com singleTask,
             abrir a tela TRAZ A EXISTENTE para a frente em vez de criar outra. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- HOME e DEFAULT ficam declarados, mas O LINKA NÃO É A TELA
                     INICIAL DA FROTA — e isso é decisão, não esquecimento.

                     O provisionamento já registrou o LINKA como tela inicial, e
                     custou dois aparelhos inutilizáveis. Reproduzido em hardware
                     limpo (0581c2b): Razr apagado, provisionado, reiniciado na
                     hora, nunca mais ligou. O log:

                        No home screen found for Intent { MAIN + HOME } user 0

                     Durante o boot travado o Android só enxerga componentes
                     preparados para rodar antes do destravamento. A única tela
                     inicial do aparelho era a nossa, inalcançável, sem reserva
                     permitida — e o boot não terminava nunca. Não aparece no
                     provisionamento porque o launcher antigo ainda está de pé:
                     só o PRIMEIRO REINÍCIO revela, e aí o aparelho já está na loja.

                     Hoje quem devolve a vitrine são três caminhos que NÃO
                     conseguem impedir o aparelho de ligar: o quiosque, o retorno
                     por inatividade e o BootReceiver. Menos garantido que ser
                     dono da tela inicial, e é a troca certa.

                     ── POR QUE ENTÃO CONTINUAM DECLARADOS ────────────────────
                     Porque são pré-requisito para religar aquilo um dia, e porque
                     sem eles o aparelho não teria como nos escolher nem quando
                     alguém escolhe à mão. O resto do pré-requisito também já
                     está de pé: directBootAware no aplicativo e Prefs no
                     armazenamento protegido por aparelho, para o token sobreviver
                     à fase travada.

                     RELIGAR EXIGE VALIDAR ANTES, e o teste é específico: apagar
                     um aparelho de verdade, provisionar e reiniciar com a fixação
                     ligada. Enquanto esse teste não existir, fica desligado.

                     Em 31/08 esta explicação estava no tempo presente e afirmava
                     que o provisionamento ainda fixava a tela inicial. Custou uma
                     investigação inteira atrás de um defeito que não existia. -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- A TV não olha para LAUNCHER: ela lista só quem declara esta
                     categoria. É a linha que coloca o LINKA na tela inicial da
                     Android TV, do mesmo jeito que LAUNCHER faz no celular. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A vitrine volta sozinha depois de qualquer reinício.
             SEM directBootAware e SEM LOCKED_BOOT_COMPLETED, e isso não é
             detalhe: com eles, o receptor roda ANTES de o aparelho destravar,
             fase em que a memória do app ainda não existe. A leitura falhava, o
             processo morria — e como o LINKA é a tela inicial deste aparelho, o
             sistema ficava esperando uma tela que nunca subia. Dois aparelhos de
             teste ficaram presos na inicialização por minutos.
             BOOT_COMPLETED sozinho chega depois do destravamento, que é quando
             a vitrine tem como funcionar de verdade. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Atualizacao do app tambem mata a vitrine: o processo morre e o
                     Android nao levanta de volta. Sem isto, uma versao nova que
                     entra com o cliente na camera deixa a loja apagada ate alguem
                     reiniciar o aparelho. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Recebe o cargo de dono do aparelho (ADR-7). -->
        <receiver
            android:name=".LinkaDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".HeartbeatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Responde ao assistente do Android durante a leitura do QR. Sem ela,
             o provisionamento e cancelado no meio a partir do Android 10. -->
        <activity
            android:name=".ProvisioningActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A SEGUNDA pergunta, e ela e obrigatoria desde o Android 11. Sem
                 ela o assistente cancela DEPOIS de baixar e instalar o app, com a
                 mensagem generica de "algo deu errado" — que faz todo mundo
                 procurar defeito no arquivo, e nao aqui. -->
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Recebe o "fale comigo agora". Nao exportado para outros apps: quem
             fala com ele e o Google Play Services, que usa a permissao abaixo. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
